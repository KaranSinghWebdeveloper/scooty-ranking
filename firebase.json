{
    "hosting": {
        "site": "kainchi-dham-booking",
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "robots.txt",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/plain"
                    }
                ]
            },
            {
                "source": "sitemap.xml",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/xml"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "/robots.txt",
                "destination": "/robots.txt"
            },
            {
                "source": "/sitemap.xml",
                "destination": "/sitemap.xml"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}